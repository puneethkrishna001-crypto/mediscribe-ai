# ============================================================================
# MediScribe AI - Environment Configuration
# ============================================================================

# REQUIRED: Google Gemini API Key
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_gemini_api_key_here

# ============================================================================
# Optional: Paths (leave as-is for defaults)
# ============================================================================

# Path to medical documents directory
# DATA_PATH=data

# Path to vector store
# VECTORSTORE_PATH=vectorstore

# ============================================================================
# Optional: Model Configuration
# ============================================================================

# Embedding model (hugging face model identifier)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM model identifier
# GEMINI_MODEL=gemini-2.5-flash

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
# Lower values recommended for medical accuracy
# TEMPERATURE=0.3

# Maximum tokens in response
# MAX_TOKENS=1024

# ============================================================================
# Optional: Retrieval Configuration
# ============================================================================

# Number of documents to retrieve per query
# TOP_K=8

# Chunk size for document splitting (characters)
# CHUNK_SIZE=500

# Overlap between chunks (characters)
# CHUNK_OVERLAP=50

# ============================================================================
# Optional: Development/Debugging
# ============================================================================

# Set to true for verbose logging
# DEBUG=false

# Enable caching
# ENABLE_CACHE=true

# Cache directory
# CACHE_DIR=.cache

# ============================================================================
# Notes:
# - Values with # prefix are optional and use defaults
# - Required values must be set before running the application
# - Uncomment lines to use custom values
# ============================================================================
